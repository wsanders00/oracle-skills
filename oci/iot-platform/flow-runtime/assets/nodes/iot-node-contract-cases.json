  "contract": {
    "authenticationFamilies": {
      "managedIotConfig": {
        "nodeType": "iot-config",
        "paletteLabel": "OCI Config",
        "classification": "managed-documented",
        "authFamily": "oci-api",
        "childRoles": ["telemetry", "subscribe", "send command"],
        "deviceMqttSession": false,
        "sourceIds": ["O1"]
      },
      "sampleDeviceIotConfig": {
        "nodeType": "iot-config",
        "paletteLabel": "iot-config",
        "classification": "sample-package",
        "authFamily": "device-mqtts",
        "childRoles": ["iot-telemetry", "iot-subscribe"],
        "deviceMqttSession": true,
        "sourceIds": ["S4"],
        "targetAvailability": "not-proven-without-target-palette-inspection"
      },
      "sampleOciConfig": {
        "nodeType": "oci-config",
        "paletteLabel": "oci-config",
        "classification": "sample-package",
        "authFamily": "oci-api",
        "childRoles": ["iot-send-command", "iot-get-content", "iot-update-relationship"],
        "deviceMqttSession": false,
        "sourceIds": ["S4"],
        "targetAvailability": "not-proven-without-target-palette-inspection"
      }
    },
    "deviceMqtt": {
      "transport": "MQTTS",
      "documentedPort": 8883,
      "tlsRequired": true,
      "clientId": "unique-per-simultaneous-session",
      "session": "persistent-session-is-a-selected package/target behavior; verify before relying on it",
      "boundedSettings": ["keepalive", "connectTimeoutMs", "operationTimeoutMs", "reconnectAttempts", "reconnectBackoffMs"],
      "proxy": "unsupported-unless-selected-node-revision-documents-proxy-support",
      "qos": [0, 1, 2]
    },
    "telemetry": {
      "roles": ["telemetry", "iot-telemetry"],
      "topicSelection": "configured non-empty topic wins; trimmed msg.topic is used only when configured topic is blank",
      "payload": "non-object payload becomes {value: payload}; null passes through unchanged when auto-timestamp is off but errors on payload.time access when enabled; arrays pass through as arrays (named time is not JSON-stringified)",
      "timestamp": "pinned iot-telemetry addTimestamp inserts epoch microseconds when payload.time == null; existing values are not unit-validated",
      "qos": "configured/runtime values are Number-normalized independently of payload shape; invalid runtime msg.qos warns and falls back to configured QoS",
      "acceptanceBoundary": "transport/service acceptance is not normalization, history, or device processing"
    },
    "subscription": {
      "roles": ["subscribe", "iot-subscribe"],
      "wildcard": {"plus": "one complete level", "hash": "one complete final level"},
      "qos": "invalid configured QoS falls back to 1 in the pinned package",
      "payloadModes": ["parsed-any-valid-json-value", "original-string"],
      "outputs": ["fullTopic", "topicSuffix"],
      "suffix": "pattern ending /# returns remainder after prefix; fixed, +, and exact # return last received segment",
      "acknowledgement": "receipt is not command acknowledgement; response publication must be explicit"
    },
    "sendCommand": {
      "roles": ["send command", "iot-send-command"],
      "requestEndpoint": "required exact endpoint/topic; msg.requestEndpoint overrides configured value",
      "responseEndpoint": "required only when waitForResponse is true; msg.responseEndpoint overrides configured value and output is omitted when false",
      "durations": "source regex after upper-casing: P date/time components with optional T and fractional seconds; syntax validation only",
      "waitModes": ["wait-for-response", "no-wait"],
      "outputs": ["status", "commandStatusLocation", "recordId", "rawCommandDataRecordId", "opcRequestId", "requestEndpoint", "responseEndpoint-when-waiting"],
      "acceptedState": "accepted-unconfirmed",
      "completion": "device completion requires API response or separate status evidence; this node does not poll"
    },
    "objectStorage": {
      "classification": "official-scenario",
      "sourceIds": ["C11"],
      "selection": ["download", "upload"],
      "downloadInputs": ["namespace", "bucket", "objectName"],
      "uploadInputs": ["namespace", "bucket", "objectName", "filePathOrContent"],
      "downloadOutput": "Buffer plus selected metadata",
      "encoding": "explicit before text/CSV parsing",
      "indexRule": "advance only after download success",
      "acceptanceBoundary": "Object Storage acceptance is not device-host publication"
    },
    "notifications": {
      "classification": "official-scenario",
      "sourceIds": ["C12"],
      "inputs": ["topic", "title", "body"],
      "runtimeOverrides": "only documented message overrides",
      "outputs": ["publishResult", "messageId"],
      "acceptanceBoundary": "publication acceptance is not subscriber delivery"
    },
    "optionalExtensions": {
      "classification": "sample-package-compatibility-gated",
      "sourceIds": ["S4"],
      "immutableRevisionRequired": true,
      "boundedPoll": {"intervalMs": 1000, "timeoutMs": 5000, "concurrency": 1, "queueLimit": 2},
      "ords": ["ords-config", "one-shot-request", "bounded-poll"],
      "requestModes": ["raw-command", "raw-data", "rejected-data", "snapshot", "historized-data", "custom-relative-path"],
      "digitalTwin": ["content-read", "relationship-content-update"],
      "relationship": {
        "keyGrammar": "sourceTwinOcid->targetTwinOcid:contentPath",
        "parser": "first -> and first : delimiters; trim and require non-empty source, target, and contentPath",
        "keyPrecedenceImplementation": "non-null msg.relationshipKey wins even when it is explicitly empty (empty then permits payload key); null/absent top-level key uses configured default, and payload key is skipped when that default is selected",
        "contentPrecedenceImplementation": "defined msg.content, then plain-object msg.payload.content, then configured object default; defined null or missing payload.content blocks later fallback",
        "contentRequirement": "plain non-array object"
      },
      "logging": ["oci-custom-logging-upload", "log-analytics-upload"],
      "runtimeLoggingDistinct": true
    }
  },
